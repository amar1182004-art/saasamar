# Application
CRYSTELL_ENV=development
WEB_PORT=3000
API_PORT=3001
AI_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001

# PostgreSQL administrative role (migrations only)
POSTGRES_DB=crystell_development
POSTGRES_USER=crystell_admin
POSTGRES_PASSWORD=change-me-admin-local-only
MIGRATION_DATABASE_URL=postgresql://crystell_admin:change-me-admin-local-only@postgres:5432/crystell_development

# PostgreSQL restricted merchant runtime role
APP_DATABASE_USER=crystell_app
APP_DATABASE_PASSWORD=change-me-app-local-only
DATABASE_URL=postgresql://crystell_app:change-me-app-local-only@postgres:5432/crystell_development

# PostgreSQL restricted control-plane runtime role
CONTROL_PLANE_DATABASE_USER=crystell_control_app
CONTROL_PLANE_DATABASE_PASSWORD=change-me-control-local-only
CONTROL_PLANE_DATABASE_URL=postgresql://crystell_control_app:change-me-control-local-only@postgres:5432/crystell_development

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=1

# Object storage (local MinIO)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crystell-local
S3_ACCESS_KEY=crystell-local
S3_SECRET_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true
PRODUCT_IMAGE_MAX_BYTES=20971520
PRODUCT_VIDEO_MAX_BYTES=262144000
PRODUCT_MEDIA_UPLOAD_TTL_SECONDS=600
SUPPORT_FILE_MAX_BYTES=26214400
SUPPORT_VIDEO_MAX_BYTES=262144000
SUPPORT_ATTACHMENT_UPLOAD_TTL_SECONDS=600

# AI service
AI_SERVICE_URL=http://ai:8000
AI_INTERNAL_TOKEN=change-me-local-only

# Billing and attribution
AFFILIATE_ATTRIBUTION_DAYS=30

# Payments
# Production must provide a strict-base64 value that decodes to exactly 32 random bytes.
# Development/test intentionally leave this blank and derive an isolated key from APP_SECRET_KEY_BASE.
PAYMENT_SECRETS_KEY=

# Shipping
# Production must provide a strict-base64 value that decodes to exactly 32 random bytes.
# Development/test intentionally leave this blank and derive an isolated key from APP_SECRET_KEY_BASE.
SHIPPING_SECRETS_KEY=

# Email, SMS and WhatsApp providers
# Production must provide a strict-base64 value that decodes to exactly 32 random bytes.
# Development/test intentionally leave this blank and derive an isolated key from APP_SECRET_KEY_BASE.
COMMUNICATION_SECRETS_KEY=

# Control plane
# Production must provide a strict-base64 value that decodes to exactly 32 random bytes.
CONTROL_PLANE_SECRETS_KEY=
CONTROL_PLANE_SESSION_TTL_MINUTES=60
CONTROL_PLANE_ELEVATION_TTL_MINUTES=10
CONTROL_PLANE_LOCKOUT_THRESHOLD=5
CONTROL_PLANE_LOCKOUT_SECONDS=1800

# Security
APP_SECRET_KEY_BASE=replace-with-a-long-random-value-at-least-64-characters-before-production
SESSION_METADATA_KEY=replace-with-a-separate-long-random-value
SESSION_TTL_HOURS=168
LOGIN_THROTTLE_KEY=replace-with-a-separate-long-random-value
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_MAX_PAIR_ATTEMPTS=8
LOGIN_MAX_IP_ATTEMPTS=60
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_SECONDS=900
MFA_ENCRYPTION_KEY=replace-with-a-separate-high-entropy-mfa-encryption-key
MFA_RECOVERY_PEPPER=replace-with-a-separate-high-entropy-recovery-pepper
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
IDENTITY_DELIVERY_ENCRYPTION_KEY=replace-with-a-separate-high-entropy-delivery-encryption-key
IDENTITY_DELIVERY_FINGERPRINT_KEY=replace-with-a-separate-high-entropy-delivery-fingerprint-key
IDENTITY_REQUEST_THROTTLE_KEY=replace-with-a-separate-high-entropy-identity-request-key
IDENTITY_REQUEST_WINDOW_SECONDS=3600
IDENTITY_MAX_PAIR_REQUESTS=5
IDENTITY_MAX_IP_REQUESTS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
TENANT_INVITATION_TTL_HOURS=168
TENANT_CONTEXT_HEADER=X-Crystell-Tenant
