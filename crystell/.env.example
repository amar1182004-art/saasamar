# Application
CRYSTELL_ENV=development
WEB_PORT=3000
API_PORT=3001
AI_PORT=8000

# PostgreSQL
POSTGRES_DB=crystell_development
POSTGRES_USER=crystell
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://crystell:change-me-local-only@postgres:5432/crystell_development

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage (local MinIO)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=crystell-local
S3_ACCESS_KEY=crystell-local
S3_SECRET_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true

# AI service
AI_SERVICE_URL=http://ai:8000
AI_INTERNAL_TOKEN=change-me-local-only

# Security
APP_SECRET_KEY_BASE=replace-with-a-long-random-value
TENANT_CONTEXT_HEADER=X-Crystell-Tenant
